<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page ? page.title + ' – South Texas Vascular Experts' : 'South Texas Vascular Experts' %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  <!-- ============ HEADER / NAV ============ -->
  <header class="site-header" id="site-header">
    <div class="header-inner container">
      <a href="/home" class="logo-link">
        <div class="logo-wrap"><img src="/logo.png" alt="South Texas Vascular Experts" class="logo" onerror="this.parentElement.style.display='none'"></div>
        <div class="brand-text">
          <span class="brand-name">South Texas</span>
          <span class="brand-sub">Vascular Experts</span>
        </div>
      </a>

      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>

      <nav class="main-nav" id="main-nav">
        <ul>
          <% if (pages && pages.length) { %>
            <% const mainNav = pages.filter(p => !['home','terms','privacy'].includes(p.slug)); %>
            <% mainNav.forEach(p => { %>
              <li><a href="/<%= p.slug %>" class="<%= (currentSlug === p.slug) ? 'active' : '' %>"><%= p.title %></a></li>
            <% }); %>
          <% } %>
          <% if (isLoggedIn) { %>
            <li><a href="/admin/dashboard" class="nav-admin-link">⚙ Admin</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <% if (page && page.content) { %>
    <section class="hero<%= (page.content.image && page.content.image !== '') ? ' has-image' : '' %>" <%- (page.content.image && page.content.image !== '') ? `style="--hero-img: url('${page.content.image}')"` : '' %>>
      <div class="hero-overlay"></div>
      <div class="hero-content container">
        <div class="hero-badge">South Texas Vascular Experts</div>
        <h1 class="hero-title"><%= page.content.header || page.title %></h1>
        <% if (page.content.heroSubtitle) { %>
          <p class="hero-subtitle"><%= page.content.heroSubtitle %></p>
        <% } %>
        <% if (currentSlug === 'home') { %>
          <div class="hero-ctas">
            <a href="/contact" class="btn btn-primary-lg">Schedule an Appointment</a>
            <a href="/services" class="btn btn-outline-lg">Our Services</a>
          </div>
        <% } else if (currentSlug === 'contact') { %>
          <div class="hero-ctas">
            <a href="tel:5551234567" class="btn btn-primary-lg">Call (555) 123-4567</a>
          </div>
        <% } %>
      </div>
      <div class="hero-scroll-hint">
        <span></span>
      </div>
    </section>
  <% } %>

  <!-- ============ MAIN CONTENT ============ -->
  <main>

    <% if (page && page.content) { %>

      <!-- ===== STAFF PAGE ===== -->
      <% if (page.content.staff && page.content.staff.length) { %>
        <section class="section section-light">
          <div class="container">
            <div class="section-intro">
              <div class="section-label">Our People</div>
              <p class="section-desc"><%= page.content.body %></p>
            </div>
          </div>
        </section>

        <!-- Doctor featured card -->
        <% const doctor = page.content.staff.find(s => s.role && s.role.includes('M.D.')); %>
        <% if (doctor) { %>
        <section class="section section-white doctor-feature">
          <div class="container">
            <div class="doctor-card">
              <div class="doctor-photo-wrap">
                <img src="<%= doctor.photo %>" alt="<%= doctor.name %>" class="doctor-photo">
              </div>
              <div class="doctor-info">
                <div class="section-label">Medical Director</div>
                <h2 class="doctor-name"><%= doctor.name %></h2>
                <p class="doctor-role"><%= doctor.role %></p>
                <p class="doctor-bio"><%= doctor.bio %></p>
                <div class="doctor-badges">
                  <span class="badge">Board-Certified</span>
                  <span class="badge">20+ Years Experience</span>
                  <span class="badge">UT Health Alumni</span>
                </div>
              </div>
            </div>
          </div>
        </section>
        <% } %>

        <!-- Nursing team grid -->
        <section class="section section-light">
          <div class="container">
            <div class="section-header">
              <div class="section-label">Nursing Team</div>
              <h2 class="section-title">The Faces Behind Your Care</h2>
            </div>
            <div class="staff-grid">
              <% const nurses = page.content.staff.filter(s => !s.role || !s.role.includes('M.D.')); %>
              <% nurses.forEach(member => { %>
                <div class="staff-card">
                  <div class="staff-photo-wrap">
                    <img src="<%= member.photo %>" alt="<%= member.name %>" class="staff-photo">
                  </div>
                  <div class="staff-card-body">
                    <h3 class="staff-name"><%= member.name %></h3>
                    <p class="staff-role"><%= member.role %></p>
                    <p class="staff-bio"><%= member.bio %></p>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </section>

      <!-- ===== HOME PAGE EXTRAS ===== -->
      <% } else if (currentSlug === 'home') { %>
        <section class="section section-white">
          <div class="container">
            <div class="features-grid">
              <div class="feature-card">
                <div class="feature-icon">🩺</div>
                <h3>Expert Vascular Care</h3>
                <p>Board-certified specialists using the latest minimally invasive techniques for optimal outcomes.</p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">💚</div>
                <h3>Patient-First Approach</h3>
                <p>Every treatment plan is tailored to your unique needs. We listen before we act.</p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">🏥</div>
                <h3>State-of-the-Art Facility</h3>
                <p>Modern clinic in San Antonio equipped with the latest imaging and treatment technology.</p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">📅</div>
                <h3>Easy Scheduling</h3>
                <p>Call or email us to schedule. Most patients are seen within one week of referral.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="section section-green-gradient">
          <div class="container">
            <div class="cta-banner">
              <div>
                <h2>Ready to Take the First Step?</h2>
                <p>Our team is here to answer your questions and get you on the path to better health.</p>
              </div>
              <a href="/contact" class="btn btn-white-lg">Contact Us Today</a>
            </div>
          </div>
        </section>

        <section class="section section-light">
          <div class="container">
            <div class="page-body-card">
              <%- page.content.body.replace(/\n/g, '<br>') %>
            </div>
          </div>
        </section>

      <!-- ===== SERVICES PAGE ===== -->
      <% } else if (currentSlug === 'services') { %>
        <section class="section section-white">
          <div class="container">
            <div class="services-list">
              <div class="service-item"><div class="service-dot"></div><div><strong>Carotid Artery Disease Management</strong><p>Stroke prevention through advanced imaging and carotid endarterectomy or stenting procedures.</p></div></div>
              <div class="service-item"><div class="service-dot"></div><div><strong>Peripheral Arterial Disease (PAD)</strong><p>Restoring blood flow to the legs with angioplasty, stenting, and bypass surgery.</p></div></div>
              <div class="service-item"><div class="service-dot"></div><div><strong>Varicose Vein Treatment</strong><p>Sclerotherapy and laser ablation to eliminate painful, unsightly varicose and spider veins.</p></div></div>
              <div class="service-item"><div class="service-dot"></div><div><strong>Dialysis Access</strong><p>Creation and maintenance of arteriovenous fistulas and grafts for dialysis patients.</p></div></div>
              <div class="service-item"><div class="service-dot"></div><div><strong>Aneurysm Repair</strong><p>Endovascular and open surgical repair of abdominal and thoracic aortic aneurysms.</p></div></div>
              <div class="service-item"><div class="service-dot"></div><div><strong>Wound Care</strong><p>Specialized wound care for diabetic ulcers, venous stasis wounds, and post-surgical healing.</p></div></div>
            </div>
          </div>
        </section>
        <section class="section section-light">
          <div class="container">
            <div class="page-body-card">
              <%- page.content.body.replace(/\n/g, '<br>') %>
            </div>
          </div>
        </section>

      <!-- ===== CONTACT PAGE ===== -->
      <% } else if (currentSlug === 'contact') { %>
        <section class="section section-white">
          <div class="container">
            <div class="contact-grid">
              <div class="contact-card">
                <div class="contact-icon">📧</div>
                <h3>Email</h3>
                <a href="mailto:jason@fauxmail.com" class="contact-detail">jason@fauxmail.com</a>
              </div>
              <div class="contact-card">
                <div class="contact-icon">📞</div>
                <h3>Phone</h3>
                <a href="tel:5551234567" class="contact-detail">(555) 123-4567</a>
              </div>
              <div class="contact-card">
                <div class="contact-icon">📍</div>
                <h3>Address</h3>
                <p class="contact-detail">123 Medical Park Drive, Suite 200<br>San Antonio, TX 78229</p>
              </div>
              <div class="contact-card">
                <div class="contact-icon">🕐</div>
                <h3>Hours</h3>
                <p class="contact-detail">Monday – Friday<br>8:00 AM – 5:00 PM</p>
              </div>
            </div>
          </div>
        </section>
        <section class="section section-light">
          <div class="container">
            <div class="page-body-card">
              <%- page.content.body.replace(/\n/g, '<br>') %>
            </div>
          </div>
        </section>

      <!-- ===== PATIENT RESOURCES PAGE ===== -->
      <% } else if (currentSlug === 'patient-resources') { %>
        <section class="section section-white">
          <div class="container">
            <div class="resources-grid">
              <div class="resource-card">
                <div class="resource-icon">📋</div>
                <h3>New Patient Forms</h3>
                <p>Download and complete your intake paperwork before your first visit to save time.</p>
                <a href="#" class="resource-link">Download Forms →</a>
              </div>
              <div class="resource-card">
                <div class="resource-icon">💳</div>
                <h3>Insurance We Accept</h3>
                <p>We accept Medicare, Medicaid, and most major commercial insurance plans.</p>
                <a href="#" class="resource-link">View Insurance List →</a>
              </div>
              <div class="resource-card">
                <div class="resource-icon">📝</div>
                <h3>Pre-Procedure Instructions</h3>
                <p>Important guidelines to follow before your scheduled procedure or imaging appointment.</p>
                <a href="#" class="resource-link">Read Instructions →</a>
              </div>
              <div class="resource-card">
                <div class="resource-icon">🎬</div>
                <h3>Educational Videos</h3>
                <p>Watch informative videos about common vascular conditions and what to expect during treatment.</p>
                <a href="#" class="resource-link">Watch Videos →</a>
              </div>
            </div>
          </div>
        </section>
        <section class="section section-light">
          <div class="container">
            <div class="page-body-card">
              <%- page.content.body.replace(/\n/g, '<br>') %>
            </div>
          </div>
        </section>

      <!-- ===== GENERIC PAGE (terms, privacy, custom) ===== -->
      <% } else { %>
        <section class="section section-white">
          <div class="container">
            <% if (page.content.video && page.content.video !== '') { %>
              <div class="media-wrapper">
                <video controls class="page-video">
                  <source src="<%= page.content.video %>" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              </div>
            <% } %>
            <div class="page-body-card">
              <%- page.content.body.replace(/\n/g, '<br>') %>
            </div>
          </div>
        </section>
      <% } %>

    <% } else { %>
      <section class="section section-white"><div class="container"><p>Page content not available.</p></div></section>
    <% } %>

  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="footer-top">
      <div class="container footer-grid">
        <div class="footer-brand">
          <div class="footer-logo-wrap"><img src="/logo.png" alt="STVE Logo" class="footer-logo" onerror="this.parentElement.style.display='none'"></div>
          <p class="footer-tagline">Compassionate vascular care for South Texas and beyond.</p>
          <p class="footer-email-badge"><a href="mailto:jason@fauxmail.com">jason@fauxmail.com</a></p>
        </div>
        <div class="footer-links-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/home">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/staff">Staff</a></li>
          </ul>
        </div>
        <div class="footer-links-col">
          <h4>Patient Info</h4>
          <ul>
            <li><a href="/patient-resources">Patient Resources</a></li>
            <li><a href="/contact">Contact Us</a></li>
            <li><a href="/terms">Terms of Service</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
          </ul>
        </div>
        <div class="footer-contact-col">
          <h4>Contact</h4>
          <p>123 Medical Park Drive, Suite 200<br>San Antonio, TX 78229</p>
          <p><strong>(555) 123-4567</strong></p>
          <p>Mon–Fri: 8:00 AM – 5:00 PM</p>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>&copy; <%= new Date().getFullYear() %> South Texas Vascular Experts. All rights reserved. | Dr. Edwardo Gutierrez, M.D.</p>
      </div>
    </div>
  </footer>

  <script>
    // Sticky header on scroll
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    });
    // Mobile nav toggle
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('main-nav');
    toggle.addEventListener('click', () => {
      nav.classList.toggle('open');
      toggle.classList.toggle('open');
    });
  </script>
</body>
</html>
